{
  "manifest_version": 3,
  "name": "NFSU2 Save Editor for nfsu2.xyz",
  "version": "0.2.0",
  "description": "Edit your nfsu2.xyz career saves offline: money, unlock all, performance, unique parts, story stage, with undo.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "alarms", "scripting"],
  "host_permissions": ["https://nfsu2.xyz/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "NFSU2 Save Editor" },
  "side_panel": { "default_path": "panel/panel.html" },
  "content_scripts": [
    { "matches": ["https://nfsu2.xyz/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
